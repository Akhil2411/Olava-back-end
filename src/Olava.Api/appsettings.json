{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "olava-api",
    "Audience": "olava-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SigningKey": ""
  },
  "Identity": {
    "RequireConfirmedEmail": false
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}